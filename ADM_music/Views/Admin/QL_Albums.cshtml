@using ADM_music.Models
@model List<GetAlbumInfoResult>
@{
    ViewBag.Title = "QL_Tracks";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="clearfix"></div>
<div class="content-wrapper">
    <div class="container-fluid">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <h5 class="card-title">Danh Sách Album</h5>
                        <div class="form-group">
                            <a href="@Url.Action("Add_Albums","Admin")" class="btn btn-light px-5"><i class="icon-plus"></i> Thêm Album Bài Hát Mới</a>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped" style="table-layout: fixed; width: 100%">
                            <thead>
                                <tr>
                                    <th scope="col"></th>
                                    <th scope="col">Tên Album</th>
                                    <th scope="col">Tên Nhạc Sĩ</th>
                                    <th scope="col">Thể Loại</th>
                                    <th scope="col">Ngày Ra Mắt</th>
                                    <th scope="col">Giá Album</th>
                                    <th scope="col">Lượt Thích</th>
                                    <th scope="col">Số Lượng</th>
                                    <th scope="col">View Album</th>
                                    <th scope="col">Edit Album</th>
                                    <th scope="col">Delete Album</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="width:10%;">
                                            <img src="@item.Img" style="width:80px; height:80px; object-fit:cover;" />
                                        </td>
                                        <td style="width: 20%;white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.TenAlbum</td>
                                        <td style="width:20%; ">@item.TenNgheSi</td>
                                        <td style="width:10%; ">@item.Genre</td>
                                        <td style="width:5%; ">@(item.ReleaseDate?.ToString(@"dd/MM/yyyy"))</td>
                                        <td style="width:5%; ">@item.Price</td>
                                        <td style="width:5%; ">@item.LikeNum</td>
                                        <td style="width:5%; ">@item.Amount</td>
                                        <td style="width:5%;"><a class="fa fa-eye fa-lg " aria-hidden="true" href="@Url.Action("View_Albums", "Admin", new { AlbumID = @item.AlbumID.Trim()})"></a></td>
                                        <td style="width:5%;"><a class="fa fa-edit fa-lg " aria-hidden="true" href="@Url.Action("Edit_Albums", "Admin", new { AlbumID = @item.AlbumID.Trim()})"></a></td>
                                        <td style="width:5%;"><a class="fa fa-trash fa-lg" aria-hidden="true" href="@Url.Action("Delete_Albums", "Admin", new { AlbumID = @item.AlbumID.Trim() })"></a></td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
