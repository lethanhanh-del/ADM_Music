@using ADM_music.Models
@model List<Artist>
@{
    ViewBag.Title = "QL_Tracks";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="clearfix"></div>
<div class="content-wrapper">
    <div class="container-fluid">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <h5 class="card-title">Danh Sách Nghệ Sĩ</h5>
                        <div class="form-group">
                            <a href="@Url.Action("Add_Artict","Admin")" class="btn btn-light px-5"><i class="icon-plus"></i> Nghệ Sĩ Mới</a>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped" style="table-layout: fixed; width: 100%">
                            <thead>
                                <tr>
                                    <th scope="col"></th>
                                    <th scope="col">Tên Nhạc Sĩ</th>
                                    <th scope="col">Thể Loại</th>
                                    <th scope="col">Ngày Sinh Nhật</th>
                                    <th scope="col">Lượt Thích</th>
                                    <th scope="col">View</th>
                                    <th scope="col">Edit</th>
                                    <th scope="col">Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="width:10%;">
                                            <img src="@item.Img" style="width:80px; height:80px; object-fit:cover;" />
                                        </td>
                                        <td style="width: 20%;white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.Name</td>
                                        <td style="width:10%; ">@item.Genre</td>
                                        <td style="width:5%; ">@(item.DateOfBirth?.ToString(@"dd/MM/yyyy"))</td>
                                        <td style="width:5%; ">@item.LikeNum</td>
                                        <td style="width:5%;"><a class="fa fa-eye fa-lg " aria-hidden="true" href="@Url.Action("View_Artict", "Admin", new { ArtistID = @item.ArtistID.Trim()})"></a></td>
                                        <td style="width:5%;"><a class="fa fa-edit fa-lg " aria-hidden="true" href="@Url.Action("Edit_Artict", "Admin", new { ArtistID = @item.ArtistID.Trim()})"></a></td>
                                        <td style="width:5%;"><a class="fa fa-trash fa-lg" aria-hidden="true" href="@Url.Action("Delete_Artict", "Admin", new { ArtistID = @item.ArtistID.Trim() })"></a></td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
