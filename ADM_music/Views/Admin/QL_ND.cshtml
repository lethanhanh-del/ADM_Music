@using ADM_music.Models
@model List<User>
@{
    ViewBag.Title = "QL_ND";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="clearfix"></div>
<div class="content-wrapper">
    <div class="container-fluid">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <h5 class="card-title">Danh Sách Người Dùng</h5>
                        <div class="form-group">
                            @*<a href="@Url.Action("Add_Albums","Admin")" class="btn btn-light px-5"><i class="icon-plus"></i> Thêm Album Bài Hát Mới</a>*@
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped" style="table-layout: fixed; ">
                            <thead>
                                <tr>
                                    <th scope="col">Tên Người Dùng</th>
                                    <th scope="col">Tên Đăng Nhập</th>
                                    <th scope="col">Email</th>
                                    <th scope="col">SDT</th>
                                    <th scope="col">Địa Chỉ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="width: 100px;white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item._Name</td>
                                        <td>@item.Usersname</td>
                                        <td>@item.Email</td>
                                        <td>@(!string.IsNullOrEmpty(item.Address) ? item.Address : "Chưa Cung Cấp")</td>
                                        <td>@(!string.IsNullOrEmpty(item.Number_Phone) ? item.Number_Phone : "Chưa Cung Cấp")</td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


