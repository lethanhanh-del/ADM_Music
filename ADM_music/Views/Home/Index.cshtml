    <script>
        let currentIndex = 0; // Start at the first set of items
        const items = document.querySelectorAll('.carousels-item');
        const totalItems = items.length;
        const itemsToShow = 2; // Number of items to show at once
        const carouselItemsContainer = document.getElementById('carouselItems');

        function updateCarousel() {
            // Move the carousel to show the current items
            const offset = (currentIndex * (32 / itemsToShow));
            carouselItemsContainer.style.transform = `translateX(-${offset}%)`;
        }

        document.getElementById('prev').addEventListener('click', () => {
            // Decrement index and loop around if needed
            currentIndex = (currentIndex - 1 + Math.ceil(totalItems / itemsToShow)) % Math.ceil(totalItems / itemsToShow);
            updateCarousel();
        });

        document.getElementById('next').addEventListener('click', () => {
            // Increment index and loop around if needed
            currentIndex = (currentIndex + 1) % Math.ceil(totalItems / itemsToShow);
            updateCarousel();
        });

        // js thanh nhạc

        document.addEventListener("DOMContentLoaded", function () {
            const audio = document.getElementById("main-audio");
            const imgArt = document.getElementById("img-art");
            const musicName = document.getElementById("music-name");
            const authorName = document.getElementById("author-name");
            const playPauseBtn = document.getElementById("play-pause-btn");
            const volumeBar = document.getElementById("volume-bar");
            const volumeFilled = document.getElementById("volume-filled");
            const progressBar = document.getElementById("progress-bar");
            const progressPlayed = document.getElementById("progress-played");
            const currentTimeText = document.getElementById("current-time");
            const maxDurationText = document.getElementById("max-duration");
            const prevBtn = document.getElementById("prev-btn");
            const nextBtn = document.getElementById("next-btn");
            const likeBtn = document.getElementById("like-btn");

            let isDragging = false;
            let isRepeat = false;
            let isMute = false;
            let volume = 1;

            const activeColor = "#1db954"; // Màu khi nút được kích hoạt
            let isPrevActive = false;
            let isNextActive = false;
            let isLike = false;

            // Cài đặt bài hát ban đầu
            let currentTrackIndex = 0; // Chuyển đổi Model sang JSON
            /* const tracks = []; // Đây sẽ là danh sách các bài hát bạn muốn phát*/

            // Thêm sự kiện để phát/dừng bài hát
            playPauseBtn.addEventListener("click", function () {
                if (audio.paused) {
                    audio.play();
                    playPauseBtn.innerHTML = '<i class="fa fa-pause-circle" style = "color : #1db954"></i>';
                } else {
                    audio.pause();
                    playPauseBtn.innerHTML = '<i class="fa fa-play-circle"></i>';
                }
            });

            likeBtn.addEventListener("click", function () {
                // Toggle lớp 'liked' để đổi màu đỏ và trở lại màu mặc định
                likeBtn.classList.toggle("liked");
            });

            // Cập nhật thời gian hiện tại
            audio.addEventListener("timeupdate", function () {
                if (!isDragging) {
                    const currentTime = audio.currentTime;
                    const progressPercent = Math.min(currentTime / audio.duration, 1);
                    progressPlayed.style.width = `${progressPercent * 100}%`;
                    currentTimeText.innerText = formatTime(currentTime);
                }
            });

            // Lặp lại bài hát khi kết thúc
            audio.addEventListener("ended", function () {
                audio.currentTime = 0; // Đặt lại về đầu bài hát
                audio.play(); // Phát lại bài hát
            });

            // Cài đặt maxDuration khi dữ liệu bài hát được tải
            audio.addEventListener("loadedmetadata", function () {
                maxDurationText.innerText = formatTime(audio.duration);
            });

            // Cho phép nhấn vào thanh tiến độ để phát từ vị trí đó
            progressBar.addEventListener("click", function (e) {
                const width = progressBar.clientWidth;
                const clickX = e.offsetX;
                const percent = clickX / width;
                audio.currentTime = percent * audio.duration; // Chuyển đến vị trí tương ứng
                progressPlayed.style.width = `${percent * 100}%`;
            });

            // Thay đổi âm lượng
            volumeBar.addEventListener("click", function (e) {
                const width = volumeBar.clientWidth;
                const offsetX = e.clientX - volumeBar.getBoundingClientRect().left;
                let percent = Math.min(offsetX / width, 1);
                audio.volume = percent;
                volumeFilled.style.width = `${percent * 100}%`;
            });

            // Chức năng định dạng thời gian
            function formatTime(time) {
                const minutes = Math.floor(time / 60);
                const seconds = Math.floor(time % 60);
                return `${minutes}:${seconds < 10 ? "0" : ""}${seconds}`;
            }

            // Điều chỉnh tốc độ phát khi nhấn nút "prev"
            prevBtn.addEventListener("click", function () {
                if (!isPrevActive) {
                    audio.playbackRate -= 0.5; // Giảm tốc độ
                    prevBtn.style.color = activeColor;
                    isPrevActive = true;
                } else {
                    audio.playbackRate = 1.0; // Trở về tốc độ bình thường
                    prevBtn.style.color = ""; // Trả về màu mặc định
                    isPrevActive = false;
                }
            });

            // Điều chỉnh tốc độ phát khi nhấn nút "next"
            nextBtn.addEventListener("click", function () {
                if (!isNextActive) {
                    audio.playbackRate += 0.5; // Tăng tốc độ
                    nextBtn.style.color = activeColor;
                    isNextActive = true;
                } else {
                    audio.playbackRate = 1.0; // Trở về tốc độ bình thường
                    nextBtn.style.color = ""; // Trả về màu mặc định
                    isNextActive = false;
                }
            });


        });
        // end js thanh nhạc

    </script>
    <script>
        let isLiked = false; // Trạng thái ban đầu (chưa like)

        function handleLikeUnlike( trackid , artistID) {
            if (isLiked) {
                // Gửi yêu cầu đến action 'unlike'
                fetch('/Home/unLike', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        if(trackid != null) {
                            itemId: trackid, // ID của đối tượng cần unlike
                        }
                        else {
                            itemId: artistID, // ID của đối tượng cần unlike
                        }
                    }),
                })
                    .then(response => response.json())
                    .then(data => {
                        console.log('Unlike success:', data);
                        isLiked = false;
                        document.getElementById('Hearts').style.fill = 'none'; // Reset màu sắc
                    })
                    .catch(error => {
                        console.error('Error:', error);
                    });
            } else {
                // Gửi yêu cầu đến action 'like'
                fetch('/Home/Like', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        itemId: '123', // ID của đối tượng cần like
                    }),
                })
                    .then(response => response.json())
                    .then(data => {
                        console.log('Like success:', data);
                        isLiked = true;
                        document.getElementById('Hearts').style.fill = '#03cafc'; // Thay đổi màu sắc
                    })
                    .catch(error => {
                        console.error('Error:', error);
                    });
            }
        }

    </script>
</body>