@using ADM_music.Models
@model Track
@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <style>
        /* css thanh nhạc*/
        /* Mặc định */
        .like-btn i {
            color: gray;
        }

        /* Khi được thích */
        .like-btn.liked i {
            color: red;
        }
        /*end  css thanh nhạc*/
        .carousels {
            margin: auto;
            max-width: 1200px;
            position: relative;
        }

        .categories__titles {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        .carousels__containers {
            display: flex;
            overflow: hidden;
            width: 100%;
        }

        .carousels-items {
            display: flex;
            transition: transform 0.5s ease;
        }

        .carousels-item {
            flex: 25%;
            padding: 10px;
            box-sizing: border-box;
        }

        .card-images img {
            width: 100%;
            border-radius: 10px;
        }


        .carousels__controls {
            position: absolute;
            top: 50%;
            width: 100%;
            display: flex;
            justify-content: space-between;
            transform: translateY(-50%);
            z-index: 1;
        }

        .carousels__control {
            background-color: transparent;
            border: none;
            cursor: pointer;
            font-size: 48px;
            color: #03cafc;
            transition: color 0.3s;
            padding: 10px;
        }

        .carousels__control:hover {
            color: #0290c8;
        }

        /*nút xem thêm */
        .view-more-button {
            font-size: 16px; /* Kích thước chữ */
            color: gray; /* Màu chữ (có thể thay đổi) */
            text-decoration: none; /* Không gạch chân */
            border: none; /* Không có đường viền */
            background: none; /* Không có màu nền */
            cursor: pointer; /* Hiển thị con trỏ tay khi hover */
        }

            .view-more-button:hover {
                text-decoration: underline; /* Gạch chân khi hover */
                color: #1db954; /* Thay đổi màu chữ khi hover (có thể thay đổi) */
            }
        /*end Nút Xem Thêm*/

    </style>
</head>
<body>
    @*Thanh play nhạc*@
    <div class="player">
        <div class="player-left">
            <img id="img-art" src=@Model.Img alt="Album Art" class="album-art" />
            <div class="track-info">
                <h3 id="music-name">@Model.Name</h3>
                <p id="author-name">@Model.Artist.Name</p>
            </div>
            <div class="controls_audio">
                <button class="like-btn" id="like-btn"><i class="fa fa-heart"></i></button>
            </div>
        </div>
        <div class="player-center">
            <div class="playback-controls_audio">

                <button id="prev-btn"><i class="fa fa-backward" aria-hidden="true"></i></button>
                <button class="play-btn" id="play-pause-btn">
                    <i class="fa fa-play-circle"></i>
                </button>
                <button id="next-btn"><i class="fa fa-forward" aria-hidden="true"></i></button>
            </div>
            <div id="progress-area">
                <p id="current-time">0:00</p>
                <p id="max-duration">0:00</p>
                <div style="clear: both"></div>
                <div id="progress-bar">
                    <audio id="main-audio" src="~/Content/Music/@Model._FILE"></audio>
                    <div id="progress-played"></div>
                </div>
            </div>
        </div>
        <div class="player-right">
            <button id="volume-btn"><i class="fa fa-volume-up"></i></button>
            <div id="volume-bar">
                <div id="volume-filled" style="width: 100%"></div>
            </div>
            <button id="fullscreen-btn"><i class="fa fa-expand"></i></button>
        </div>
    </div>

